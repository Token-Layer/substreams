# Base database URL without schemaName; chain runners append their own schema automatically.
DATABASE_URL_BASE=psql://user:password@host:5432/database?sslmode=require

# Pinax credentials for Pinax-hosted endpoints.
PINAX_API_KEY=
PINAX_API_TOKEN=

# StreamingFast credentials for non-Pinax endpoints.
STREAMINGFAST_API_KEY=
STREAMINGFAST_API_TOKEN=

# Optional sink behavior.
# HANDLE_REORGS=1 enables true DB undo/replay handling for reorgs.
# To use buffered confirmation mode instead, set HANDLE_REORGS=0 and UNDO_BUFFER_SIZE to a positive number.
HANDLE_REORGS=1
UNDO_BUFFER_SIZE=200
SUBSTREAMS_PARALLEL_WORKERS=
